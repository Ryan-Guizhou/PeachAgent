digraph PeachAgent {
  graph [rankdir=TB, bgcolor="#FFFFFF", pad=0.35, nodesep=0.42, ranksep=0.55,
    fontname="Noto Sans CJK SC", fontsize=22, fontcolor="#172D45", labelloc=t, labeljust=l];
  node [shape=box, style="rounded,filled", fontname="Noto Sans CJK SC", fontsize=14,
    color="#C8D4E2", fillcolor="#F5F8FC", fontcolor="#172D45", margin="0.22,0.16", penwidth=1.15];
  edge [color="#6A7D93", arrowsize=0.7, fontname="Noto Sans CJK SC", fontsize=11,
    fontcolor="#50657E", penwidth=1.25];
  graph [label="PeachAgent · 公共资源审核 · 批准的是不可变版本"];

  private [label="作者私有资源\n应用 / 插件 / Skill / MCP / Prompt", fillcolor="#EAF2FD", color="#91B3D7"];
  snapshot [label="准备可公开副本\n去除秘密与私有资料\n固定内容 / 代码 / 界面 / 权限摘要"];
  pending [label="提交候选版本\n作者与管理员可见", fillcolor="#FFF0E4", color="#E8AE7F"];
  review [shape=diamond,label="管理员审核", fillcolor="#FFF0E4", color="#E8AE7F"];
  reject [label="驳回 / 撤回\n修改后重新提交新候选"];
  approved [label="公开已批准版本\n目录 / 搜索 / 详情 / 下载一致", fillcolor="#EAF6EF", color="#92BEA5"];
  install [label="任何正常用户可发现并采用\n个人安装 / 绑定本人凭证 / 执行授权", fillcolor="#EAF6EF", color="#92BEA5"];
  update [label="上传新版\n旧公开版不被待审内容覆盖"];
  delist [label="普通撤回 / 风险下架\n新分发受限，既有引用按治理规则处理", fillcolor="#F1ECFA", color="#B4A1CF"];
  private -> snapshot -> pending -> review;
  review -> reject [label="不通过"];
  reject -> snapshot [label="重新准备",constraint=false];
  review -> approved [label="通过"];
  approved -> install;
  approved -> update [label="后续更新"];
  update -> pending [label="必须重新审核",constraint=false];
  approved -> delist [label="治理操作"];

}
