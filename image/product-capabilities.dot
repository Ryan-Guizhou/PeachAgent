digraph PeachAgent {
  graph [rankdir=TB, bgcolor="#FFFFFF", pad=0.35, nodesep=0.42, ranksep=0.55,
    fontname="Noto Sans CJK SC", fontsize=22, fontcolor="#172D45", labelloc=t, labeljust=l];
  node [shape=box, style="rounded,filled", fontname="Noto Sans CJK SC", fontsize=14,
    color="#C8D4E2", fillcolor="#F5F8FC", fontcolor="#172D45", margin="0.22,0.16", penwidth=1.15];
  edge [color="#6A7D93", arrowsize=0.7, fontname="Noto Sans CJK SC", fontsize=11,
    fontcolor="#50657E", penwidth=1.25];
  graph [label="PeachAgent · 四个产品域与共享能力"];

  account [label="个人用户 = 独立租户\n所有功能可用 · 自备模型与外部凭证", fillcolor="#172D45", fontcolor="white", color="#172D45"];
  studio [label="Agent Studio · 可视化开发\n工作流 / Agent / Prompt\nMCP / Skill / 知识 / 插件调试", fillcolor="#FFF0E4", color="#E8AE7F", width=3.8];
  runtime [label="Agent Runtime · 智能执行\n流程 / Agent Loop / 工具与隔离执行\n上下文 / 压缩 / 记忆 / 等待与恢复", fillcolor="#EAF2FD", color="#91B3D7", width=3.8];
  quality [label="Agent Quality · 质量中心\n任务 / RAG / Skill / 压缩 / 插件评测\nPrompt 优化 / 对比 / 人工复核", fillcolor="#EAF6EF", color="#92BEA5", width=3.8];
  operations [label="Agent Operations · 运营治理\nSa-Token / 权限 / Token 与预算\n应用发布 / 资源审核 / 部署与恢复", fillcolor="#F1ECFA", color="#B4A1CF", width=3.8];
  extension [label="跨域资源与插件\n代码能力 + 配置 + 自定义前端 · 动态版本 · 审核后共享", fillcolor="#172D45", fontcolor="white", color="#172D45"];
  {rank=same; studio; runtime;}
  {rank=same; quality; operations;}
  account -> studio [label="创建与配置"];
  account -> runtime [label="运行任务"];
  studio -> runtime [label="固定版本"];
  runtime -> quality [label="事实、证据、用量"];
  runtime -> operations [label="状态与使用记录"];
  quality -> studio [label="比较后采用新版本", constraint=false, color="#5E9B78"];
  operations -> quality [label="权限与可用范围", style=dashed];
  quality -> extension [style=dashed, arrowhead=none];
  operations -> extension [label="审核与分发"];

}
