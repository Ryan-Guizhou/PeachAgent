digraph PeachAgent {
  graph [rankdir=TB, bgcolor="#FFFFFF", pad=0.35, nodesep=0.42, ranksep=0.55,
    fontname="Noto Sans CJK SC", fontsize=22, fontcolor="#172D45", labelloc=t, labeljust=l];
  node [shape=box, style="rounded,filled", fontname="Noto Sans CJK SC", fontsize=14,
    color="#C8D4E2", fillcolor="#F5F8FC", fontcolor="#172D45", margin="0.22,0.16", penwidth=1.15];
  edge [color="#6A7D93", arrowsize=0.7, fontname="Noto Sans CJK SC", fontsize=11,
    fontcolor="#50657E", penwidth=1.25];
  graph [label="PeachAgent · 推荐技术架构 · 职责边界与数据归属"];

  web [label="Web 控制台 / 应用入口\n画布 · 调试 · 质量 · 仓库 · Token", fillcolor="#FFF0E4", color="#E8AE7F"];
  api [label="Control API · 模块化控制服务\n身份 / 资源 / 版本 / 发布审核 / 任务准入", fillcolor="#EAF2FD", color="#91B3D7"];
  runtime [label="可信 Worker\nRuntime / 资料处理 / 评测\n检查点 · 模型/工具网关", fillcolor="#EAF2FD", color="#91B3D7"];
  manager [label="可信执行管理服务\n预定义模板与限额\n受约束容器生命周期", fillcolor="#F1ECFA", color="#B4A1CF"];
  plugin [label="受限插件 / 脚本实例\n固定包版本 · 有限工作区\n无 Docker socket / 管理密钥", fillcolor="#FFF0E4", color="#E8AE7F"];
  mysql [label="MySQL · 权威记录\n租户 / 版本 / 运行\n审批 / 任务 / 用量"];
  redis [label="Redis · 加速与协调\n缓存 / 会话 / 通知\n非唯一任务事实"];
  search [label="OpenSearch · 派生索引\n文本 + 向量 / 当前权限\n可重建"];
  object [label="S3 / SeaweedFS · 权威文件\n原文 / 插件与界面包\n产物 / 报告"];
  external [label="本人外部服务\n模型 / MCP / 工具\nBYOK 与调用计量", fillcolor="#EAF6EF", color="#92BEA5"];
  {rank=same; runtime; manager;}
  {rank=same; mysql; redis; search; object;}
  {rank=same; plugin; external;}
  web -> api [label="受保护请求 / 运行事件"];
  api -> runtime [label="持久任务与版本清单"];
  api -> manager [label="安装与能力声明"];
  runtime -> manager [label="受控执行"];
  manager -> plugin [label="创建 / 回收", minlen=2];
  runtime -> mysql [label="事务事实"];
  api -> mysql [style=dashed];
  runtime -> redis [label="通知 / 限流"];
  runtime -> search [label="范围过滤检索"];
  runtime -> object [label="包与产物引用"];
  runtime -> external [label="当前授权 / 预算", minlen=2];
  plugin -> runtime [label="受控能力调用", constraint=false, style=dashed];

}
