digraph PeachAgent {
  graph [rankdir=TB, bgcolor="#FFFFFF", pad=0.35, nodesep=0.42, ranksep=0.55,
    fontname="Noto Sans CJK SC", fontsize=22, fontcolor="#172D45", labelloc=t, labeljust=l];
  node [shape=box, style="rounded,filled", fontname="Noto Sans CJK SC", fontsize=14,
    color="#C8D4E2", fillcolor="#F5F8FC", fontcolor="#172D45", margin="0.22,0.16", penwidth=1.15];
  edge [color="#6A7D93", arrowsize=0.7, fontname="Noto Sans CJK SC", fontsize=11,
    fontcolor="#50657E", penwidth=1.25];
  graph [label="PeachAgent · AI 按 ci 模板执行 · 文档流程，非自动流水线"];

  baseline [label="读取已确认需求与技术蓝图\n同时读取总 Issue、现有任务、PR 与 main", fillcolor="#172D45", fontcolor="white", color="#172D45"];
  split [label="按模板差量拆分\n需求/验收编号 · 依赖 · 范围 · 查重"];
  issue [label="开发 Issue\n围绕一个可验收结果建立分支", fillcolor="#EAF2FD", color="#91B3D7"];
  dev [label="开发与对应 PR\n关联 Issue · 说明变化与真实证据", fillcolor="#EAF2FD", color="#91B3D7"];
  gate [shape=diamond, label="适用构建与\n必要验证通过？", fillcolor="#FFF0E4", color="#E8AE7F"];
  merge [label="合并 main\n记录提交与关闭对应 Issue", fillcolor="#EAF6EF", color="#92BEA5"];
  phase [shape=diamond, label="本期全部需求\n核对完成？", fillcolor="#FFF0E4", color="#E8AE7F"];
  summary [label="更新总规划 Issue\n保留未完成项与阶段真实结论"];
  release [label="第 7 阶段上线核对\n真实部署 / 挂载 / 恢复 / 全功能联验", fillcolor="#172D45", fontcolor="white", color="#172D45"];
  baseline -> split -> issue -> dev -> gate;
  gate -> dev [label="未通过：修复", constraint=false, color="#BC6F55"];
  gate -> merge [label="通过"];
  merge -> phase;
  phase -> split [label="有缺口：回到对应任务", constraint=false, color="#BC6F55"];
  phase -> summary [label="完整证据"];
  summary -> release [label="七期收口"];

}
