digraph PeachAgent {
  graph [rankdir=TB, bgcolor="#FFFFFF", pad=0.35, nodesep=0.42, ranksep=0.55,
    fontname="Noto Sans CJK SC", fontsize=22, fontcolor="#172D45", labelloc=t, labeljust=l];
  node [shape=box, style="rounded,filled", fontname="Noto Sans CJK SC", fontsize=14,
    color="#C8D4E2", fillcolor="#F5F8FC", fontcolor="#172D45", margin="0.22,0.16", penwidth=1.15];
  edge [color="#6A7D93", arrowsize=0.7, fontname="Noto Sans CJK SC", fontsize=11,
    fontcolor="#50657E", penwidth=1.25];
  graph [label="PeachAgent · 七阶段交付 · 六期完整功能，七期部署"];

  p1 [label="01 · 个人空间与项目基础\nSa-Token / BYOK / 对话 / Token 面板 / 插件声明", fillcolor="#EAF2FD", color="#91B3D7"];
  p2 [label="02 · 可视化工作流\n拖拽 / 变量与条件 / 子流程 / 插件节点 / 两类界面", fillcolor="#EAF2FD", color="#91B3D7"];
  p3 [label="03 · Agent 与动态扩展\nMCP / Skill / 规则 / 压缩记忆 / 受控代码 / 热升级", fillcolor="#EAF2FD", color="#91B3D7"];
  p4 [label="04 · 知识与 RAG\n资料版本 / 切分 / 混合检索 / 重排引用 / 基线", fillcolor="#EAF6EF", color="#92BEA5"];
  p5 [label="05 · 质量与优化\n样本与评测 / 召回依据 / Prompt 优化 / 全量用量", fillcolor="#EAF6EF", color="#92BEA5"];
  p6 [label="06 · 完整应用与运营\n协作恢复 / 知识补全 / Web 与 API / 审核仓库", fillcolor="#FFF0E4", color="#E8AE7F"];
  p7 [label="07 · Docker Compose 部署\n密码配置 / 自动初始化 / 预设挂载 / 备份恢复", fillcolor="#172D45", fontcolor="white", color="#172D45"];
  p1 -> p2 -> p3 -> p4 -> p5 -> p6 -> p7;
  shared [label="每期共同核对\n个人租户与凭证\n版本与当前授权\n实际结果与 Token\n失败、取消与数据保留", fillcolor="#F1ECFA", color="#B4A1CF"];
  {rank=same; p4; shared;}
  shared -> p3 [style=dashed, constraint=false, arrowhead=none];
  shared -> p5 [style=dashed, constraint=false, arrowhead=none];

}
