digraph PeachAgent {
  graph [rankdir=TB, bgcolor="#FFFFFF", pad=0.35, nodesep=0.42, ranksep=0.55,
    fontname="Noto Sans CJK SC", fontsize=22, fontcolor="#172D45", labelloc=t, labeljust=l];
  node [shape=box, style="rounded,filled", fontname="Noto Sans CJK SC", fontsize=14,
    color="#C8D4E2", fillcolor="#F5F8FC", fontcolor="#172D45", margin="0.22,0.16", penwidth=1.15];
  edge [color="#6A7D93", arrowsize=0.7, fontname="Noto Sans CJK SC", fontsize=11,
    fontcolor="#50657E", penwidth=1.25];
  graph [label="PeachAgent · 插件动态生命周期 · 全局 Runtime 保持运行"];

  package [label="新插件版本\n代码 / 配置 / 界面 / 依赖声明", fillcolor="#FFF0E4", color="#E8AE7F"];
  check [label="校验与就绪\n摘要 / 兼容 / 授权 / 实例健康"];
  decision [shape=diamond,label="新版本可用？", fillcolor="#FFF0E4", color="#E8AE7F"];
  ready [label="新版本可选择\n只供显式选择的新引用", fillcolor="#EAF6EF", color="#92BEA5"];
  failure [label="失败保留记录\n仍获准的旧版可继续使用"];
  old [label="原版本与配置修订\n已发布应用 / 运行中 / 暂停 / 待审批", fillcolor="#EAF2FD", color="#91B3D7"];
  new [label="新应用或显式迁移\n建立新的版本绑定", fillcolor="#EAF6EF", color="#92BEA5"];
  auth [label="每次新动作检查当前权限与预算\n撤权 / 停用 / 风险冻结立即限制后续动作", fillcolor="#F1ECFA", color="#B4A1CF"];
  uninstall [shape=diamond,label="卸载时仍有引用？", fillcolor="#FFF0E4", color="#E8AE7F"];
  blocked [label="展示引用与处理方式\n不能静默替换旧任务"];
  remove [label="回收实例和包引用\n数据保留 / 删除单独处理"];
  package -> check -> decision;
  decision -> ready [label="是"];
  decision -> failure [label="否"];
  ready -> new;
  failure -> old;
  check -> old [label="既有引用保持原版",style=dashed,constraint=false];
  {rank=same; old; new;}
  old -> auth; new -> auth;
  auth -> uninstall [label="生命周期操作"];
  uninstall -> blocked [label="有"];
  uninstall -> remove [label="无"];

}
