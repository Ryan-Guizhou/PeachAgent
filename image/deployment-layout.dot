digraph PeachAgent {
  graph [rankdir=TB, bgcolor="#FFFFFF", pad=0.35, nodesep=0.42, ranksep=0.55,
    fontname="Noto Sans CJK SC", fontsize=22, fontcolor="#172D45", labelloc=t, labeljust=l];
  node [shape=box, style="rounded,filled", fontname="Noto Sans CJK SC", fontsize=14,
    color="#C8D4E2", fillcolor="#F5F8FC", fontcolor="#172D45", margin="0.22,0.16", penwidth=1.15];
  edge [color="#6A7D93", arrowsize=0.7, fontname="Noto Sans CJK SC", fontsize=11,
    fontcolor="#50657E", penwidth=1.25];
  graph [label="PeachAgent · Docker Compose 默认部署蓝图 · 未来发行契约"];

  user [label="部署者\n配置数据库与中间件密码\n一条启动命令", fillcolor="#172D45", fontcolor="white", color="#172D45"];
  subgraph cluster_web {
    label="仅发布受控 Web 入口"; color="#E8AE7F"; style="rounded";
    main [label="主入口 HTTPS 18443\n控制台 / API / 应用", fillcolor="#FFF0E4", color="#E8AE7F"];
    ui [label="插件静态 HTTPS 18444\n受限 iframe / 通道绑定\n无登录及业务 API", fillcolor="#FFF0E4", color="#E8AE7F"];
    {rank=same;main;ui;}
  }
  subgraph cluster_trusted {
    label="Compose 内部网络 · 不向公网发布中间件"; color="#91B3D7"; style="rounded";
    api [label="控制 API\n身份 / 资源 / 审核",fillcolor="#EAF2FD",color="#91B3D7"];
    worker [label="可信 Worker\n运行 / 知识 / 评测",fillcolor="#EAF2FD",color="#91B3D7"];
    manager [label="执行管理服务\n唯一受约束管理入口",fillcolor="#F1ECFA",color="#B4A1CF"];
    {rank=same;api;worker;manager;}
    db [label="MySQL\n事务与运行事实"];
    redis [label="Redis\n会话与协调"];
    search [label="OpenSearch\n检索索引"];
    s3 [label="SeaweedFS / S3\n资料 / 包 / 产物"];
    {rank=same;db;redis;search;s3;}
  }
  isolated [label="按任务/版本的受限执行实例\n无 socket / 管理密码 / 宿主根目录",fillcolor="#FFF0E4",color="#E8AE7F"];
  disk [label="预设挂载与生命周期\n持久数据 / 内部密钥 / 包缓存 / 工作区 / 日志\n区分权威数据、可重建缓存与临时文件",fillcolor="#EAF6EF",color="#92BEA5"];
  backup [label="一致备份与空环境恢复\n包含权威文件、事务数据与解密密钥\n挂载 ≠ 备份；恢复后核验未决任务",fillcolor="#172D45",fontcolor="white",color="#172D45"];
  user -> main [label="初始化与状态检查"];
  user -> ui [label="默认可用，无额外 DNS"];
  main -> api;
  ui -> main [label="宿主受控桥接",style=dashed,constraint=false];
  api -> worker [label="持久任务"];
  worker -> manager [label="限定实例请求"];
  manager -> isolated [label="创建 / 回收",minlen=2];
  api -> db; api -> redis;
  worker -> search; worker -> s3;
  db -> disk; redis -> disk; search -> disk; s3 -> disk;
  isolated -> disk [label="只限授权工作区",style=dashed];
  disk -> backup;

}
