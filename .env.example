# Local development only. Copy to .env, fill secrets and QQ SMTP credentials; do not commit .env.
# Values must be single-line, unquoted, without spaces or shell metacharacters.
# Use an existing MySQL 5.7 instance via DB_URL, or set MYSQL_IMAGE=mysql:5.7.44 for a fresh Compose volume.
MYSQL_IMAGE=mysql:8.4
MYSQL_ROOT_PASSWORD=
DB_USER=peachagent
DB_PASSWORD=
DB_URL=jdbc:mysql://127.0.0.1:3306/peachagent
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
# Redis 7.4 is the default; Redis 3.0.7 and 3.2.12 are compatibility targets.
REDIS_IMAGE=redis:7.4-alpine
# Use a separate volume when testing Redis 3.x against data created by Redis 7.x.
REDIS_DATA_VOLUME=peachagent_redis_data
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
# Full QQ email address and SMTP authorization code (not the QQ login password).
SMTP_USER=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_SSL=true
SMTP_TLS=false
# Set to the same QQ email address; if omitted the application uses SMTP_USER.
# MAIL_FROM=
SERVER_PORT=8080
PUBLIC_ORIGIN=http://127.0.0.1:5173
COOKIE_SECURE=false
# Base64 encoding of exactly 32 random bytes; same persistent value in API and Worker.
CREDENTIAL_KEK=
CREDENTIAL_KEK_VERSION=1
# Empty by default: private/loopback HTTP endpoints are blocked.
PEACHAGENT_ALLOWED_INTERNAL_ORIGINS=
PEACHAGENT_ARTIFACT_DIRECTORY=./data/artifacts
