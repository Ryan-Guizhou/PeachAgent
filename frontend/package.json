{
  "name": "peachagent-studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "qa:browser": "node qa/p1-browser-smoke.mjs",
    "format": "prettier --write \"src/**/*.{ts,vue,css}\" vite.config.ts",
    "format:check": "prettier --check \"src/**/*.{ts,vue,css}\" vite.config.ts"
  },
  "dependencies": {
    "pinia": "3.0.3",
    "vue": "3.5.46",
    "vue-router": "4.5.1"
  },
  "devDependencies": {
    "@types/node": "22.18.10",
    "@vitejs/plugin-vue": "6.0.1",
    "playwright": "1.64.0",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "vite": "7.3.8",
    "vue-tsc": "3.1.1"
  }
}
